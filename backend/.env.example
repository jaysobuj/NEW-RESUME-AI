# Copy this to .env and fill in your values
# Port the backend runs on
PORT=5000
# Long random string to sign JWT sessions
JWT_SECRET=replace_with_a_random_string_at_least_16_characters_long
# How long login sessions last
JWT_EXPIRES_IN=30d
# Get your free Gemini key at https://aistudio.google.com/apikey
# If left empty, the app uses local rule-based logic (still fully working)
GEMINI_API_KEY=
# Gemini model (free tier as of July 2026)
GEMINI_MODEL=gemini-3.5-flash
# Frontend URL for CORS
CLIENT_ORIGIN=http://localhost:3000
